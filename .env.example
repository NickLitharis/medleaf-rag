# MedLeaf RAG environment. Copy to .env and adjust; never commit real secrets.
# Variable names only — no credentials are stored in this file.

# --- Corpus -------------------------------------------------------------------
MEDLEAF_DATA_DIR=data
MEDLEAF_CORPUS_VERSION=dev
MEDLEAF_USER_AGENT=medleaf-rag/0.1 (+https://github.com/NickLitharis/medleaf-rag)
MEDLEAF_REQUEST_TIMEOUT_S=60
MEDLEAF_MAX_SECTION_TOKENS=400

# --- Embeddings ---------------------------------------------------------------
MEDLEAF_EMBED_MODEL=intfloat/multilingual-e5-base
# Pin the model commit so an index rebuild cannot silently change the vectors.
MEDLEAF_EMBED_REVISION=d128750597153bb5987e10b1c3493a34e5a4502a
MEDLEAF_EMBED_DEVICE=cpu
MEDLEAF_EMBED_BATCH_SIZE=32
MEDLEAF_EMBED_MAX_SEQ_LENGTH=512
MEDLEAF_EMBED_CACHE_DIR=data/models

# --- Retrieval store ----------------------------------------------------------
MEDLEAF_QDRANT_URL=http://127.0.0.1:6333
# MEDLEAF_QDRANT_API_KEY=
MEDLEAF_QDRANT_COLLECTION=medleaf_chunks
MEDLEAF_PREFETCH_LIMIT=30
MEDLEAF_DEFAULT_LIMIT=10

# --- Local stack ports --------------------------------------------------------
MEDLEAF_QDRANT_HTTP_PORT=6333
MEDLEAF_QDRANT_GRPC_PORT=6334
MEDLEAF_API_PORT=8000
